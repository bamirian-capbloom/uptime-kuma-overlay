new file mode 100644
index 0000000000000000000000000000000000000000..e4dbd0429a11e009798ada59de3f446a28a11829
--- /dev/null
+++ b/src/components/DependencySuppressionSummary.vue
@@ -0,0 +1,192 @@
+<template>
+    <section
+        v-if="rows.length"
+        class="shadow-box big-padding mb-3 suppression-summary"
+        aria-labelledby="suppression-summary-heading"
+        data-testid="dependency-suppression-summary"
+    >
+        <h2 id="suppression-summary-heading" class="h5 mb-3">
+            {{ $t("dependencySuppressedFailureAlerts", { count: rows.length }) }}
+        </h2>
+        <table class="table table-borderless mb-0 suppression-table">
+            <caption class="visually-hidden">
+                {{ $t("dependencySuppressionTableDescription") }}
+            </caption>
+            <thead>
+                <tr>
+                    <th scope="col">{{ $t("dependencyAffectedMonitor") }}</th>
+                    <th scope="col">{{ $t("dependencyMonitorState") }}</th>
+                    <th scope="col">{{ $t("dependencySuppressedBy") }}</th>
+                </tr>
+            </thead>
+            <tbody>
+                <tr v-for="row in rows" :key="row.monitor.id" :data-testid="`suppression-row-${row.monitor.id}`">
+                    <th scope="row" class="affected-monitor">
+                        <span class="mobile-label" aria-hidden="true">{{ $t("dependencyAffectedMonitor") }}</span>
+                        <router-link :to="`/dashboard/${row.monitor.id}`" data-testid="suppression-monitor-link">
+                            <bdi>{{ row.monitor.name }}</bdi>
+                        </router-link>
+                        <details
+                            class="dependency-path mt-2"
+                            :open="expanded[row.monitor.id] || false"
+                            @toggle="expanded[row.monitor.id] = $event.target.open"
+                        >
+                            <summary>{{ $t("dependencyPath") }}</summary>
+                            <ol v-if="expanded[row.monitor.id]" class="mt-2 mb-0">
+                                <li v-for="monitor in row.path" :key="monitor.id">
+                                    <router-link :to="`/dashboard/${monitor.id}`">
+                                        <bdi>{{ monitor.name }}</bdi>
+                                    </router-link>
+                                </li>
+                            </ol>
+                        </details>
+                    </th>
+                    <td>
+                        <span class="mobile-label" aria-hidden="true">{{ $t("dependencyMonitorState") }}</span>
+                        <Status :status="0" />
+                    </td>
+                    <td>
+                        <span class="mobile-label" aria-hidden="true">{{ $t("dependencySuppressedBy") }}</span>
+                        <div class="blocker">
+                            <router-link
+                                :to="`/dashboard/${row.blocker.id}`"
+                                class="blocker-link"
+                                data-testid="suppression-blocker-link"
+                            >
+                                <bdi>{{ row.blocker.name }}</bdi>
+                            </router-link>
+                            <Status :status="0" />
+                        </div>
+                    </td>
+                </tr>
+            </tbody>
+        </table>
+    </section>
+</template>
+
+<script>
+import Status from "./Status.vue";
+
+export default {
+    components: { Status },
+    data() {
+        return { expanded: {} };
+    },
+    computed: {
+        rows() {
+            if (!this.$root.socket.connected) {
+                return [];
+            }
+            // The existing resolver owns suppression semantics and accepted-beat ordering.
+            // Its blocker may be further along the chain than the configured dependency.
+            const monitors = this.$root.monitorList;
+            return Object.entries(this.$root.dependencyObservations)
+                .map(([id, observation]) => ({
+                    monitor: monitors[id],
+                    blocker: monitors[observation.blockerId],
+                    path: [Number(id), ...observation.ancestors].map((ancestor) => monitors[ancestor]).filter(Boolean),
+                }))
+                .filter((row) => row.monitor && row.blocker);
+        },
+    },
+};
+</script>
+
+<style scoped>
+.suppression-summary {
+    min-width: 0;
+}
+
+.suppression-table {
+    width: 100%;
+    table-layout: fixed;
+}
+
+.suppression-table th,
+.suppression-table td {
+    padding: 0.75rem;
+    vertical-align: top;
+    overflow-wrap: anywhere;
+    text-align: start;
+}
+
+.suppression-table thead th:nth-child(2) {
+    width: 22%;
+}
+
+.affected-monitor {
+    font-weight: normal;
+}
+
+.dependency-path {
+    font-size: 0.875rem;
+}
+
+.dependency-path summary {
+    cursor: pointer;
+}
+
+.dependency-path ol {
+    padding-inline-start: 1.5rem;
+}
+
+.blocker {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: baseline;
+    gap: 0.35rem;
+    min-width: 0;
+}
+
+.blocker-link {
+    min-width: 0;
+}
+
+.mobile-label {
+    display: none;
+}
+
+@media (max-width: 700px) {
+    .suppression-table thead {
+        position: absolute;
+        width: 1px;
+        height: 1px;
+        padding: 0;
+        overflow: hidden;
+        clip: rect(0, 0, 0, 0);
+        white-space: nowrap;
+    }
+
+    .suppression-table tbody,
+    .suppression-table tr {
+        display: block;
+    }
+
+    .suppression-table tbody tr {
+        display: grid;
+        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
+        margin-block-end: 1rem;
+    }
+
+    .suppression-table tbody tr:last-child {
+        margin-block-end: 0;
+    }
+
+    .suppression-table th,
+    .suppression-table td {
+        display: block;
+        padding: 0.35rem;
+        min-width: 0;
+    }
+
+    .affected-monitor {
+        grid-column: 1 / -1;
+    }
+
+    .mobile-label {
+        display: block;
+        margin-block-end: 0.35rem;
+        font-weight: 600;
+    }
+}
+</style>
