diff --git a/test/e2e/specs/dependency-suppression-summary.spec.js b/test/e2e/specs/dependency-suppression-summary.spec.js
new file mode 100644
index 0000000000000000000000000000000000000000..ed28611c8d288bd319439046018b388333b5884d
--- /dev/null
+++ b/test/e2e/specs/dependency-suppression-summary.spec.js
@@ -0,0 +1,191 @@
+import { expect, test } from "../fixtures";
+import { login, restoreSqliteSnapshot } from "../util-test";
+
+// Each scenario includes real form saves, reconnects or several navigation steps.
+test.setTimeout(60000);
+
+/**
+ * Create a real push monitor with an optional direct dependency.
+ * @param {import('@playwright/test').Page} page Browser page
+ * @param {string} name Monitor name
+ * @param {string|null} dependency Direct dependency ID
+ * @returns {Promise<{id: string, url: string}>} Persisted monitor and push endpoint
+ */
+async function addMonitor(page, name, dependency = null) {
+    await page.getByRole("link", { name: "Add New Monitor", exact: true }).click();
+    await page.getByTestId("monitor-type-select").selectOption("push");
+    await page.getByTestId("friendly-name-input").fill(name);
+    if (dependency) {
+        await page.getByLabel("Monitor Dependency", { exact: true }).selectOption(dependency);
+    }
+    const url = await page.locator("#push-url").inputValue();
+    await page.getByTestId("save-button").click();
+    await page.waitForURL(/\/dashboard\/\d+$/);
+    return { id: page.url().split("/").pop(), url };
+}
+
+/**
+ * Submit an observed state through the actual push handler.
+ * @param {import('@playwright/test').APIRequestContext} request HTTP client
+ * @param {object} monitor Push monitor
+ * @param {string} status UP or DOWN
+ * @returns {Promise<void>} Resolves after accepted push
+ */
+async function push(request, monitor, status) {
+    const url = new URL(monitor.url);
+    url.searchParams.set("status", status);
+    expect((await (await request.get(url.toString())).json()).ok).toBe(true);
+}
+
+/**
+ * Create Website -> Gateway -> Router and start with accepted UP observations.
+ * @param {import('@playwright/test').Page} page Browser page
+ * @param {import('@playwright/test').APIRequestContext} request HTTP client
+ * @param {string[]} names Optional display names, root first
+ * @returns {Promise<object>} Chain monitors
+ */
+async function chain(page, request, names = ["Router", "Gateway", "Website"]) {
+    const router = await addMonitor(page, names[0]);
+    const gateway = await addMonitor(page, names[1], router.id);
+    const website = await addMonitor(page, names[2], gateway.id);
+    for (const monitor of [router, gateway, website]) {
+        await push(request, monitor, "up");
+    }
+    await page.goto("./dashboard");
+    return { router, gateway, website };
+}
+
+const summary = (page) => page.getByTestId("dependency-suppression-summary");
+const row = (page, monitor) => page.getByTestId(`suppression-row-${monitor.id}`);
+
+test.beforeEach(async ({ page }) => {
+    await restoreSqliteSnapshot();
+    await page.goto("./dashboard");
+    await login(page);
+    await expect(page.getByRole("link", { name: "Add New Monitor", exact: true })).toBeVisible();
+});
+
+test("summary names the current blocker, exposes linked paths and preserves actual DOWN counts", async ({
+    page,
+    request,
+}) => {
+    const { router, gateway, website } = await chain(page, request);
+    await expect(summary(page)).toHaveCount(0);
+    for (const monitor of [router, gateway, website]) {
+        await push(request, monitor, "down");
+    }
+    await expect(summary(page).getByRole("heading")).toHaveText("Suppressed failure alerts (2)");
+    await expect(row(page, website).getByTestId("suppression-monitor-link")).toHaveAttribute(
+        "href",
+        `/dashboard/${website.id}`
+    );
+    await expect(row(page, website).getByTestId("suppression-blocker-link")).toHaveText("Gateway");
+    await expect(row(page, gateway).getByTestId("suppression-blocker-link")).toHaveAttribute(
+        "href",
+        `/dashboard/${router.id}`
+    );
+    await expect(page.locator(".num.text-danger")).toHaveText("3");
+    const disclosure = row(page, website).locator("summary");
+    await disclosure.focus();
+    await disclosure.press("Enter");
+    await expect(row(page, website).locator("details")).toHaveAttribute("open", "");
+    await expect(row(page, website).locator("ol a")).toHaveText(["Website", "Gateway", "Router"]);
+    await expect(row(page, website).locator("ol a").last()).toHaveAttribute("href", `/dashboard/${router.id}`);
+    await row(page, website).getByTestId("suppression-blocker-link").click();
+    await page.waitForURL(`**/dashboard/${gateway.id}`);
+    await expect(page.getByRole("heading", { level: 1 })).toContainText("Gateway");
+    await page.goto("./dashboard");
+    await expect(summary(page).getByRole("heading")).toHaveText("Suppressed failure alerts (2)");
+
+    // The direct dependency is now UP; the actual blocker is the more distant Router.
+    await push(request, gateway, "up");
+    await expect(row(page, gateway)).toHaveCount(0);
+    await expect(row(page, website).getByTestId("suppression-blocker-link")).toHaveText("Router");
+    await expect(page.locator(".num.text-danger")).toHaveText("2");
+    await row(page, website).locator("summary").click();
+    await expect(row(page, website).locator("ol a")).toHaveText(["Website", "Gateway", "Router"]);
+    await push(request, router, "up");
+    await expect(summary(page)).toHaveCount(0);
+    await expect(page.locator(".num.text-danger")).toHaveText("1");
+});
+
+test("summary reconciles edits, pause, deletion, disconnect and stale history", async ({ page, request }) => {
+    const { router, gateway, website } = await chain(page, request);
+    await push(request, router, "down");
+    await push(request, website, "down");
+    await expect(row(page, website).getByTestId("suppression-blocker-link")).toHaveText("Router");
+    await page.context().setOffline(true);
+    await expect(summary(page)).toHaveCount(0);
+    await page.context().setOffline(false);
+    await page.reload();
+    await expect(row(page, website).getByTestId("suppression-blocker-link")).toHaveText("Router");
+    await push(request, router, "up");
+    await page.evaluate((id) => {
+        const root = document.querySelector("#app").__vue_app__._container._vnode.component.proxy;
+        root.updateLastBeat(id, { status: 0, time: "2000-01-01 00:00:00.000" });
+    }, router.id);
+    await expect(summary(page)).toHaveCount(0);
+    await push(request, router, "down");
+    await expect(row(page, website)).toBeVisible();
+    await page.goto(`./edit/${website.id}`);
+    await expect(page.getByTestId("friendly-name-input")).toHaveValue("Website");
+    await page.getByLabel("Monitor Dependency", { exact: true }).selectOption({ label: "None" });
+    await page.getByTestId("save-button").click();
+    await expect(page.getByText("Saved.", { exact: true })).toBeVisible();
+    await page.goto("./dashboard");
+    await expect(summary(page)).toHaveCount(0);
+    await page.goto(`./edit/${website.id}`);
+    await expect(page.getByTestId("friendly-name-input")).toHaveValue("Website");
+    await page.getByLabel("Monitor Dependency", { exact: true }).selectOption(gateway.id);
+    await page.getByTestId("save-button").click();
+    await expect(page.getByText("Saved.", { exact: true })).toBeVisible();
+    await page.goto(`./dashboard/${router.id}`);
+    await page.getByRole("button", { name: "Pause", exact: true }).click();
+    await page.locator(".modal.show").getByRole("button", { name: "Yes", exact: true }).click();
+    await expect(page.getByRole("button", { name: "Resume", exact: true })).toBeVisible();
+    await page.goto("./dashboard");
+    await expect(summary(page)).toHaveCount(0);
+    await page.goto(`./dashboard/${router.id}`);
+    await page.getByRole("button", { name: "Resume", exact: true }).click();
+    await expect(page.getByRole("button", { name: "Pause", exact: true })).toBeVisible();
+    await push(request, router, "down");
+    await page.goto("./dashboard");
+    await expect(row(page, website)).toBeVisible();
+    await page.goto(`./dashboard/${router.id}`);
+    await page.getByRole("button", { name: "Delete", exact: true }).click();
+    await page.locator(".modal.show").getByRole("button", { name: "Yes", exact: true }).click();
+    await page.goto("./dashboard");
+    await expect(summary(page)).toHaveCount(0);
+});
+
+test("summary escapes long names and stays usable on a narrow dark RTL dashboard", async ({
+    page,
+    request,
+}, testInfo) => {
+    const name = '<img src=x onerror="window.summaryInjected=true"> بوابة ' + "Long dependency ".repeat(5);
+    const { router, website } = await chain(page, request, [name, "Gateway " + "بوابة ".repeat(12), "Website"]);
+    await push(request, router, "down");
+    await push(request, website, "down");
+    await expect(row(page, website).getByTestId("suppression-blocker-link")).toHaveText(name);
+    await expect(summary(page).locator("img")).toHaveCount(0);
+    expect(await page.evaluate(() => window.summaryInjected)).toBeUndefined();
+    await page.screenshot({ path: testInfo.outputPath("summary-desktop.png"), animations: "disabled" });
+    await page.evaluate(() => {
+        localStorage.locale = "ar-SY";
+    });
+    await page.reload();
+    await expect(page.locator("html")).toHaveAttribute("dir", "rtl");
+    await page.evaluate(() => {
+        document.body.classList.add("dark");
+    });
+    await page.setViewportSize({ width: 390, height: 844 });
+    await expect(summary(page)).toBeVisible();
+    await row(page, website).locator("summary").focus();
+    await page.keyboard.press("Enter");
+    await expect(row(page, website).locator("ol a")).toHaveText(["Website", "Gateway " + "بوابة ".repeat(12), name]);
+    await expect.poll(() => page.evaluate(() => document.documentElement.scrollWidth)).toBeLessThanOrEqual(390);
+    const bounds = await summary(page).boundingBox();
+    expect(bounds.x).toBeGreaterThanOrEqual(0);
+    expect(bounds.x + bounds.width).toBeLessThanOrEqual(390);
+    await page.screenshot({ path: testInfo.outputPath("summary-mobile-dark-rtl.png"), animations: "disabled" });
+});
