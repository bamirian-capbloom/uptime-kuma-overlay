+                retryInterval: 1,
+                maxretries: 1,
+                dependencyMonitorId: b,
+                notificationIDList: notifications,
+            })
+        );
+        await waitFor(async () => {
+            const result = await call(socket, "getMonitorBeats", httpChild, 24);
+            return result.data?.some((beat) => beat.status === 2) && result.data?.some((beat) => beat.status === 0);
+        });
+        await waitFor(async () => statuses(httpChild).length === 1);
+        assert.deepEqual(statuses(httpChild), [0]);
+        await push(b, "down");
+        endpointStatus.set("/health", 200);
+        await waitFor(async () => statuses(httpChild).length === 2);
+        assert.deepEqual(statuses(httpChild), [0, 1]);
+        endpointStatus.set("/health", 503);
+        await waitFor(async () => {
+            const result = await call(socket, "getMonitorBeats", httpChild, 24);
+            return result.data?.filter((beat) => beat.status === 0).length >= 2;
+        });
+        assert.deepEqual(statuses(httpChild), [0, 1]);
+        endpointStatus.set("/health", 200);
+        await waitFor(async () => {
+            const result = await call(socket, "getMonitorBeats", httpChild, 24);
+            return result.data?.at(-1).status === 1;
+        });
+        assert.deepEqual(statuses(httpChild), [0, 1]);
+        // Actual repeats resume after release and remain blocked during a parent outage.
+        const repeat = await pushMonitor("Repeats", b, { resendInterval: 1 });
+        await push(repeat, "down");
+        assert.deepEqual(statuses(repeat), []);
+        await push(b, "up");
+        await push(repeat, "down");
+        await push(repeat, "down");
+        assert.deepEqual(statuses(repeat), [0, 0]);
+        await push(b, "down");
+        await push(repeat, "down");
+        assert.deepEqual(statuses(repeat), [0, 0]);
+        await push(repeat, "up");
+        assert.deepEqual(statuses(repeat), [0, 0, 1]);
+
+        // Child checks can finish while a parent's notification is still in flight.
+        const slow = await pushMonitor("Slow-root");
+        const fast = await pushMonitor("Fast-child", slow);
+        await push(slow, "up");
+        await push(fast, "up");
+        let release: () => void;
+        deliveryGates.set(
+            "Slow-root",
+            new Promise<void>((resolve) => {
+                release = resolve;
+            })
+        );
+        const slowFailure = push(slow, "down");
+        try {
+            await waitFor(async () => statuses(slow).length === 1);
+            await push(fast, "down");
+            assert.deepEqual(statuses(fast), []);
+        } finally {
+            release();
+            await slowFailure;
+        }
+        deliveryGates.delete("Slow-root");
+        await push(slow, "up");
+        await push(fast, "down");
+        assert.deepEqual(statuses(fast), [0]);
+    } catch (error) {
+        t.diagnostic(output);
+        throw error;
+    }
+});
diff --git a/test/backend-test/test-dependency-mariadb.ts b/test/backend-test/test-dependency-mariadb.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ebefea1d4a90b94635067e10b5b25a241d86deb4
--- /dev/null
+++ b/test/backend-test/test-dependency-mariadb.ts
@@ -0,0 +1,56 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { createRequire } from "node:module";
+import { MariaDbContainer } from "@testcontainers/mariadb";
+const require = createRequire(import.meta.url);
+const dependency = require("../../db/knex_migrations/2026-11-05-0000-add-monitor-dependency");
+const notification = require("../../db/knex_migrations/2026-11-06-0000-dependency-notification-state");
+
+test(
+    "MariaDB dependency migrations preserve old monitors, enforce cleanup and roll back",
+    {
+        timeout: 180000,
+        skip:
+            (!!process.env.CI && (process.platform !== "linux" || process.arch !== "x64")) ||
+            Boolean(process.env.SKIP_TESTCONTAINER),
+    },
+    async (t) => {
+        const container = await new MariaDbContainer("mariadb:10.11").withStartupTimeout(90000).start();
+        t.after(() => container.stop());
+        const db = require("knex")({
+            client: "mysql2",
+            connection: {
+                host: container.getHost(),
+                port: container.getPort(),
+                user: container.getUsername(),
+                password: container.getUserPassword(),
+                database: container.getDatabase(),
+            },
+        });
+        t.after(() => db.destroy());
+        await db.schema.createTable("monitor", (table) => {
+            table.increments("id");
+            table.string("name");
+        });
+        await db("monitor").insert([
+            { id: 1, name: "Legacy" },
+            { id: 2, name: "Parent" },
+        ]);
+        await dependency.up(db);
+        await notification.up(db);
+        assert.equal((await db("monitor").where({ id: 1 }).first()).dependency_monitor_id, null);
+        await db("monitor").where({ id: 1 }).update({ dependency_monitor_id: 2 });
+        await db("monitor_notification_state").insert({ monitor_id: 2, status: 0, incident_open: true });
+        await assert.rejects(db("monitor").where({ id: 1 }).update({ dependency_monitor_id: 999 }));
+        await db("monitor").where({ id: 2 }).del();
+        assert.equal((await db("monitor").where({ id: 1 }).first()).dependency_monitor_id, null);
+        assert.equal(await db("monitor_notification_state").first(), undefined);
+        await notification.down(db);
+        await dependency.down(db);
+        assert.equal(await db.schema.hasColumn("monitor", "dependency_monitor_id"), false);
+        assert.equal((await db("monitor").where({ id: 1 }).first()).name, "Legacy");
+        await dependency.up(db);
+        await notification.up(db);
+        assert.equal((await db("monitor").where({ id: 1 }).first()).dependency_monitor_id, null);
+    }
+);
