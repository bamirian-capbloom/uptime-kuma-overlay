index 0000000000000000000000000000000000000000..de27424db7ffc5c1e1a71babe02c34c8c2f6b34b
--- /dev/null
+++ b/docs/dependency-notifications.md
@@ -0,0 +1,67 @@
+# Dependency notification suppression (Step 3)
+
+A monitor has one direct dependency (`dependency_monitor_id`); the full ancestor
+chain is evaluated. Checks, retries, heartbeat UP/DOWN/PENDING/MAINTENANCE values,
+heartbeat importance, uptime calculations, status pages and metrics keep their
+existing meaning. Only ordinary status notifications and their repeats are gated. Both scheduled
+checks and incoming push API heartbeats use the same notification state machine.
+Certificate and domain expiry notifications are unchanged.
+
+## Decisions
+
+- Any active ancestor whose latest observed status is DOWN blocks downstream DOWN
+  notifications, even when an intermediate ancestor is unknown or paused.
+- An active unknown or PENDING ancestor defers a new DOWN alert until its state is
+  conclusive. This can defer indefinitely if that ancestor never checks. Unknown
+  is not presented as confirmed-down suppression.
+- A paused ancestor's own stored DOWN is ignored. Traversal continues through it.
+  MAINTENANCE is not treated as DOWN; its ancestors are still evaluated.
+- An incident first observed during suppression stays silent on recovery. If its
+  dependencies become available while it is still down, the next child check
+  sends one DOWN, even with repeat notifications disabled. Later repeats use the
+  existing resend interval.
+- An incident already announced before a parent outage retains its recovery
+  notification. Its repeats are blocked during the outage. Existing maintenance
+  transition notification rules still apply.
+- Removing a dependency releases deferred notifications on the next child check.
+
+`monitor_notification_state` separately persists the latest observed check state,
+whether an incident was announced, and whether delivery is deferred. Existing
+incidents are conservatively treated as previously announced if the prior
+heartbeat was DOWN when this state is first created. State is removed when the
+monitor is deleted. This migration does not change heartbeat history or monitor
+configuration columns.
+
+Live dashboard heartbeat events add `dependencyNotification` with `suppressed`,
+`reason`, `suppressedByMonitorId` (when blocked by DOWN), `waitingForMonitorId`
+(when waiting), `incidentOpen` and `deferred`. This is derived metadata for a later
+UI stage, not a replacement for heartbeat status. Historical heartbeat records
+and legacy monitor configuration APIs keep their existing shape. The exported
+`dependencyMetadata()` resolver can recompute dependency metadata after restart.
+
+## Ordering and delivery limits
+
+Notification decisions are serialized per monitor in this server process.
+New observations are persisted before consulting ancestors or sending notifications; descendants
+can use them before the corresponding heartbeat history write completes.
+Unknown and retrying parents defer child alerts regardless of check order.
+Concurrent push requests carrying the same stale transition are deduplicated.
+An UP following an announced DOWN uses the serialized incident state even when
+its push request read stale heartbeat history. This also preserves recovery when
+the initial DOWN push is still delivering and neither request has stored a beat.
+A parent last confirmed UP cannot predict a future failure: a child can alert
+before that parent's next check detects DOWN. No fixed grace period is imposed.
+Parent recovery releases the child on its next scheduled check, not immediately.
+
+The incident records survive restarts; the latest persisted DOWN remains a
+confirmed observation until a new parent check supersedes it. Serialization is
+process-local, consistent with the existing single-server monitor scheduler.
+Slow notification providers delay subsequent decisions for that monitor, without
+blocking other monitors' checks or notification decisions.
+
+Delivery retains the existing notification-provider behavior: provider failures
+are logged by `Monitor.sendNotification`, which does not report per-provider
+success. Incident state therefore tracks notification attempts, not guaranteed
+receipt or individual recipient state. As with existing alerts, a process crash
+between external delivery and the state write can duplicate an alert. Exactly-once
+external delivery is not promised. No UI controls or status redesign is included.
diff --git a/server/dependency-notification.js b/server/dependency-notification.js
new file mode 100644
index 0000000000000000000000000000000000000000..8092da4530b1bcee3dc3faab9b382cb0782b25a5
--- /dev/null
+++ b/server/dependency-notification.js
@@ -0,0 +1,137 @@
+const { R } = require("redbean-node");
+const { UP, DOWN, PENDING, MAINTENANCE } = require("../src/util");
+
+const pending = new Map();
+
+/**
+ * Resolve the whole chain. Paused and maintenance ancestors do not block alerts,
+ * but their own ancestors still can. Unknown/retrying ancestors defer a new
+ * incident until a conclusive check; they are not reported as confirmed DOWN.
+ * @param {object} monitor Monitor being checked
+ * @returns {Promise<object>} Derived notification metadata
+ */
+async function dependencyMetadata(monitor) {
+    let id = monitor.dependency_monitor_id;
+    const visited = new Set([Number(monitor.id)]);
+    let waitingForMonitorId = null;
+    while (id) {
+        if (visited.has(Number(id))) {
+            return { suppressed: false, waitingForMonitorId: id, reason: "invalid-chain" };
+        }
+        visited.add(Number(id));
+        const parent = await R.knex("monitor").where({ id }).first();
+        if (!parent) {
+            break;
+        }
+        if (parent.active) {
+            const observed = await R.knex("monitor_notification_state").where({ monitor_id: id }).first();
+            const heartbeat =
+                observed || (await R.knex("heartbeat").where({ monitor_id: id }).orderBy("id", "desc").first());
+            if (heartbeat?.status === DOWN) {
+                return { suppressed: true, suppressedByMonitorId: id, reason: "ancestor-down" };
+            }
+            if (!heartbeat || heartbeat.status === PENDING || ![UP, DOWN, MAINTENANCE].includes(heartbeat.status)) {
+                waitingForMonitorId ??= id;
+            }
+        }
+        id = parent.dependency_monitor_id;
+    }
+    return { suppressed: false, waitingForMonitorId, reason: waitingForMonitorId ? "ancestor-unconfirmed" : null };
+}
+
+/**
+ * A monitor may be deleted while its check or notification is in flight. The
+ * foreign key prevents resurrection; do not fail a completed notification when
+ * deletion won that race. Other database failures must still propagate.
+ * @param {Function} db Knex connection
+ * @param {object} state Notification state
+ * @returns {Promise<boolean>} Whether the monitor still exists
+ */
+async function persistState(db, state) {
+    try {
+        await db("monitor_notification_state").insert(state).onConflict("monitor_id").merge();
+        return true;
+    } catch (error) {
+        if (!(await db("monitor").where({ id: state.monitor_id }).first())) {
+            return false;
+        }
+        throw error;
+    }
+}
+
+/**
+ * Serialize each monitor's notification decisions without blocking other checks.
+ * State is independent of heartbeat status/importance and survives restarts.
+ * Legacy incidents are initialized as open when their preceding beat was DOWN.
+ * @param {object} monitor Monitor being checked
+ * @param {object} beat Current heartbeat
+ * @param {object|null} previous Previous heartbeat
+ * @param {boolean} requested Legacy transition/repeat notification decision
+ * @param {Function} send Send the existing payload; receives true for an announced incident's recovery
+ * @returns {Promise<object>} Suppression metadata for future UI consumers
+ */
+function processDependencyNotification(monitor, beat, previous, requested, send) {
+    const key = Number(monitor.id);
+    const action = (pending.get(key) || Promise.resolve()).then(async () => {
+        const db = R.knex;
+        let state = await db("monitor_notification_state").where({ monitor_id: monitor.id }).first();
+        if (!state) {
+            state = { monitor_id: monitor.id, incident_open: previous?.status === DOWN, deferred: false };
+        }
+        const priorObservedStatus = state.status;
+        state.status = beat.status;
+        // Publish the check before consulting ancestors or awaiting providers.
+        // A slow notification must not hide a confirmed observation from children.
+        if (!(await persistState(db, state))) {
+            return { suppressed: false, reason: "monitor-deleted", incidentOpen: false, deferred: false };
+        }
+        const metadata = await dependencyMetadata(monitor);
+        let notify = requested;
+        if (beat.status === DOWN) {
+            const blocked = metadata.suppressed || metadata.waitingForMonitorId;
+            notify =
+                !blocked &&
+                (state.deferred ||
+                    (requested && (previous?.status === DOWN || priorObservedStatus !== DOWN || !state.incident_open)));
+            if (notify) {
+                state.deferred = true;
+                if (!(await persistState(db, state))) {
+                    return { suppressed: false, reason: "monitor-deleted", incidentOpen: false, deferred: false };
+                }
+                await send();
+                beat.downCount = 0;
+                state.incident_open = true;
+                state.deferred = false;
+            } else if (!state.incident_open) {
+                state.deferred = true;
+            }
+        } else if (beat.status === UP) {
+            // A suppressed incident must not produce an orphan recovery. An
+            // already announced incident still recovers even if a parent fails.
+            notify =
+                (state.incident_open && priorObservedStatus === DOWN) ||
+                (requested && (state.incident_open || (!state.deferred && priorObservedStatus !== UP)));
+            if (notify) {
+                await send(Boolean(state.incident_open));
+            }
+            state.incident_open = false;
+            state.deferred = false;
+        } else {
+            notify = false;
+        }
+        await persistState(db, state);
+        const currentMetadata =
+            beat.status === DOWN ? metadata : { suppressed: false, waitingForMonitorId: null, reason: null };
+        return { ...currentMetadata, incidentOpen: Boolean(state.incident_open), deferred: Boolean(state.deferred) };
+    });
+    const settled = action.catch(() => {});
+    pending.set(key, settled);
+    settled.then(() => {
+        if (pending.get(key) === settled) {
+            pending.delete(key);
+        }
+    });
+    return action;
+}
+
+module.exports = { processDependencyNotification, dependencyMetadata };
