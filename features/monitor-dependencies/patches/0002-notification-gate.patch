+        t.integer("dependency_monitor_id");
+        t.boolean("active");
+    });
+    await db.schema.createTable("heartbeat", (t) => {
+        t.increments("id");
+        t.integer("monitor_id");
+        t.integer("status");
+    });
+    await migration.up(db);
+});
+after(async () => {
+    await migration.down(db);
+    await db.destroy();
+});
